<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <ImageView
                android:id="@+id/btnDialogClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentLeft="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#999999"
                android:contentDescription="Close" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="تنبيه من النظام 🛡️"
                android:textStyle="bold"
                android:textColor="#1A73E8"
                android:textSize="16sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/dialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="جاري معالجة البيانات، يرجى عدم إغلاق التطبيق."
            android:textColor="#333333"
            android:textSize="15sp"
            android:gravity="right"
            android:lineSpacingExtra="5dp" />

        <EditText
            android:id="@+id/dialogInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/editbox_background"
            android:hint="أدخل المطلوب هنا..."
            android:paddingHorizontal="15dp"
            android:gravity="right"
            android:inputType="text"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDialogAction"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="موافق"
            android:backgroundTint="#1A73E8"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
