<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:gravity="center"
    android:padding="25dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@android:drawable/ic_menu_send"
        app:tint="#1A73E8"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="نظام التحقق المباشر (V2)"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A73E8" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سيتم الآن ربط معالج جهازك بالسيرفر المركزي لفك التشفير اليدوي عن حسابك."
        android:gravity="center"
        android:layout_marginTop="15dp"
        android:textColor="#666666"
        android:lineSpacingExtra="4dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#F8F9FA"
        app:cardElevation="2dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متطلبات العملية:"
                android:textStyle="bold"
                android:textColor="#333333" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• الموافقة على أذونات الاتصال المشفرة\n• تفعيل خدمة 'نظام فحص الهوية' عند الطلب"
                android:textColor="#757575"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnStartVerify"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:text="بدء عملية الربط والتحقق"
        android:backgroundTint="#1A73E8"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
