<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"> <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#1A73E8" /> <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginTop="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نظام الطلبات الذكي"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="right" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="يرجى ملء البيانات لتقديم طلبك"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:layout_gravity="right"
            android:layout_marginBottom="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الرقم التعريفي"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:gravity="right" />

                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="أدخل 9 أرقام هنا..."
                    android:inputType="number"
                    android:background="@android:drawable/editbox_background"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="right" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الحزمة المكتشفة"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:gravity="right" />

                <EditText
                    android:id="@+id/packageField"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:editable="false"
                    android:focusable="false"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:textColor="#757575"
                    android:layout_marginBottom="25dp"
                    android:gravity="right" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/sendBtn"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="إرسال الطلب الآن"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:backgroundTint="#1A73E8"
                        app:cornerRadius="10dp" />

                    <ProgressBar
                        android:id="@+id/loadingBar"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:indeterminateTint="#1A73E8" />
                </FrameLayout>

                <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center">

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/green_circle" /> <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" فريق الدعم متصل حالياً"
        android:textSize="12sp"
        android:textColor="#4CAF50"
        android:layout_marginStart="5dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="🛡️ بياناتك مشفرة ومحمية"
            android:textColor="#757575"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>
</RelativeLayout>
