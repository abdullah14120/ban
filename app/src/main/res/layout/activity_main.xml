<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/main_toolbar_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        android:fitsSystemWindows="true"> <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/internal_action_bar_size"
            app:title="نظام الحماية المتقدم"
            app:titleCentered="true"
            app:titleTextAppearance="@style/AppearanceFoundation.Headline" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/l3"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/l1">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/l1"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/l1">

                    <TextView
                        style="@style/AppearanceFoundation.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بيانات فحص الحظر" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/l_75"
                        android:layout_marginBottom="@dimen/l1"
                        android:background="#F0F0F0" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="رقم الهاتف أو الحساب"
                        app:boxCornerRadiusBottomEnd="@dimen/r1"
                        app:boxCornerRadiusBottomStart="@dimen/r1"
                        app:boxCornerRadiusTopEnd="@dimen/r1"
                        app:boxCornerRadiusTopStart="@dimen/r1"
                        app:startIconDrawable="@android:drawable/ic_menu_edit">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtUserName"
                            style="@style/AppearanceFoundation.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/AppearanceFoundation.Caption.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/l1"
                        android:layout_marginBottom="@dimen/l_50"
                        android:text="نوع الحظر المطلوب فكه:" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@drawable/edittext_rounded_green"
                        android:paddingHorizontal="@dimen/l_75">
                        <Spinner
                            android:id="@+id/spinnerBanType"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:spinnerMode="dropdown" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmit"
                        style="@style/WidgetFoundation.Button"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/l2"
                        android:text="إرسال طلب التحقق"
                        app:backgroundTint="?colorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWatchVideo"
                        style="@style/WidgetFoundation.Button.Video"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/l_50"
                        android:text="مشاهدة فيديو الشرح" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/l1"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_lock_lock"
                        app:tint="?colorPrimary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/l_75">

                        <TextView
                            style="@style/AppearanceFoundation.Tiny.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="بياناتك مشفرة بالكامل"
                            android:textColor="?colorPrimaryVariant" />

                        <TextView
                            style="@style/AppearanceFoundation.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="نستخدم بروتوكول حماية متقدم لضمان سرية طلبك." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/mainProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="?colorPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
