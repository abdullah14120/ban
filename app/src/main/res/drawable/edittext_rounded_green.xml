<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFFFFF" /> <stroke
                android:width="2dp"
                android:color="#2E7D32" /> <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#FFFFFF" /> <stroke
                android:width="1dp"
                android:color="#DADCE0" /> <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
