<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- الثيم الأساسي للتطبيق - تم تحديثه ليدعم Material 3 ويمنع الانهيارات -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- الألوان الأساسية متوافقة مع الهوية الهادئة والديناميكية -->
        <item name="colorPrimary">?attr/colorSecondary</item>
        <item name="android:windowBackground">?attr/colorVibrant</item>
        
        <!-- تخصيص شريط الحالة العلوي (StatusBar) ليكون شفافاً وهادئاً -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- إضافة التوافقية مع العناصر المقتبسة سابقاً -->
        <item name="colorSurfaceContainer">?attr/colorSurfaceVariant</item>
        <item name="colorSurfaceContainerLow">?attr/colorSurface</item>
    </style>

    <!-- تخصيص ثيم المظهر لـ FixEngine المتناسق مع النوافذ -->
    <style name="Theme.FixEngine" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">?attr/colorSecondary</item>
        <item name="android:windowBackground">?attr/colorVibrant</item>
    </style>

    <!-- تنسيقات النصوص (Typography) بأسلوب الهوية البصرية للهيدر والعناوين -->
    <style name="AppearanceFoundation.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-black</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppearanceFoundation.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppearanceFoundation.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOutline</item>
    </style>

    <style name="AppearanceFoundation.Caption.Primary" parent="AppearanceFoundation.Caption">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppearanceFoundation.Tiny.Bold" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- تنسيقات الأزرار الاحترافية بنظام الحواف المستديرة الناعمة للـ WDS -->
    <style name="WidgetFoundation.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="WidgetFoundation.Button.Video" parent="WidgetFoundation.Button">
        <item name="backgroundTint">?attr/colorError</item>
        <item name="icon">@android:drawable/ic_media_play</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- ستايل مخصص مفقود كان يطلبه ملف الماتيريال للتأثيرات التفاعلية -->
    <style name="CustomTabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

</resources>
