<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryVariant</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="android:statusBarColor">#40bdbdbd</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppearanceFoundation.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/colorPrimaryVariant</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppearanceFoundation.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppearanceFoundation.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="AppearanceFoundation.Caption.Primary" parent="AppearanceFoundation.Caption">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppearanceFoundation.Tiny.Bold" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetFoundation.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">60dp</item>
        <item name="app:cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="WidgetFoundation.Button.Video" parent="WidgetFoundation.Button">
        <item name="backgroundTint">@color/colorError</item>
        <item name="icon">@android:drawable/ic_media_play</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>
